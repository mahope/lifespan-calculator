---
import Base from '../layouts/Base.astro'
---

<Base title="Siden findes ikke | Levetidsberegner" description="Adressen findes ikke, eller siden er flyttet." path="/404" noindex promo={false}>
  <main class="flex-1 grid place-items-center px-4 py-16 text-center">
    <div>
      <h1 class="text-3xl font-bold mb-3">Siden findes ikke</h1>
      <p class="text-muted-foreground mb-6">Adressen findes ikke, eller siden er flyttet.</p>
      <a href="/" class="btn btn-primary">Gå til Levetidsberegneren</a>
    </div>
  </main>
</Base>

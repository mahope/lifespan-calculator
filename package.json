{
  "name": "lifespan-calculator",
  "version": "1.0.0",
  "description": "Danish Lifespan Calculator - Interactive React web application",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/check-guard.mjs dist",
    "preview": "astro preview",
    "start": "astro preview --port 3000",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx}\""
  },
  "keywords": [
    "lifespan",
    "calculator",
    "danish",
    "statistics",
    "health",
    "react"
  ],
  "author": "Mads Holst Jensen <mahope.dk>",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "homepage": "https://github.com/mahope/lifespan-calculator",
  "repository": {
    "type": "git",
    "url": "https://github.com/mahope/lifespan-calculator.git"
  },
  "dependencies": {
    "@astrojs/react": "7.1.2",
    "@astrojs/sitemap": "3.7.4",
    "@vite-pwa/astro": "2.0.0",
    "astro": "7.4.4",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.23.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "4.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "prettier": "^3.9.4",
    "tailwindcss": "^4.3.2",
    "vitest": "^4.1.9"
  }
}

---
const links = [
  ['/', 'Levetidsberegneren'],
  ['/hvor-lang-tid-har-jeg-tilbage', 'Hvor lang tid har jeg tilbage?'],
  ['/pensionsalder', 'Hvornår kan jeg gå på pension?'],
  ['/levetid-beregner-danmark', 'Levetid i Danmark'],
  ['/levealder-kommuner', 'Levealder i kommunerne'],
  ['/levetid/mand/40', 'Levetid for en 40-årig mand'],
  ['/levetid/kvinde/65', 'Levetid for en 65-årig kvinde'],
]
---

<footer class="bg-muted/50 border-t mt-8 sm:mt-16">
  <div class="container py-8 sm:py-12">
    <div class="footer-grid">
      <div class="space-y-3">
        <h2 class="text-lg font-semibold text-foreground">Datakilde</h2>
        <p class="text-muted-foreground text-sm leading-relaxed">
          Tallene bygger på Danmarks Statistiks dødelighedstavle (HISB8, perioden 2024–2025). Det er gennemsnit for
          alle danskere i en bestemt alder og køn, ikke en forudsigelse for den enkelte.
        </p>
      </div>
      <div class="space-y-3">
        <h2 class="text-lg font-semibold text-foreground">Privatliv</h2>
        <p class="text-muted-foreground text-sm leading-relaxed">
          Beregningen kører i din browser. Alder, køn og fødselsdato sendes ikke til nogen server og gemmes ikke.
          Besøg tælles med selvhostet Plausible uden cookies.
          <a href="/privatlivspolitik.html" class="text-primary hover:underline">Privatlivspolitik</a> ·
          <a href="/cookiepolitik.html" class="text-primary hover:underline">Cookiepolitik</a>
        </p>
      </div>
      <div class="space-y-1">
        <h2 class="text-lg font-semibold text-foreground">Sider</h2>
        <ul>
          {links.map(([href, label]) => (
            <li><a href={href} class="text-primary hover:underline text-sm inline-flex items-center min-h-[44px] py-2">{label}</a></li>
          ))}
        </ul>
      </div>
    </div>
    <div class="border-t pt-8 mt-8 text-center space-y-3">
      <p class="text-sm text-muted-foreground italic">
        Kun til information og underholdning. Søg professionel rådgivning ved spørgsmål om helbred, pension eller forsikring.
      </p>
      <p class="text-sm text-muted-foreground">
        Udviklet af <a href="https://mahope.dk" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">Mads Holst Jensen – Mahope.dk</a>
      </p>
    </div>
  </div>
</footer>

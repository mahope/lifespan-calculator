{
  "name": "lifespan-calculator",
  "version": "1.0.0",
  "description": "Danish Lifespan Calculator - static Astro site with React islands",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/gen-sitemap.mjs",
    "build": "astro build",
    "postbuild": "node scripts/build-sw.mjs && node scripts/check-parity.mjs && node scripts/check-js-budget.mjs",
    "preview": "astro preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx}\"",
    "test:e2e": "playwright test"
  },
  "keywords": [
    "lifespan",
    "calculator",
    "danish",
    "statistics",
    "health",
    "react"
  ],
  "author": "Mads Holst Jensen <mahope.dk>",
  "license": "MIT",
  "engines": {
    "node": ">=22.23.4"
  },
  "homepage": "https://github.com/mahope/lifespan-calculator",
  "repository": {
    "type": "git",
    "url": "https://github.com/mahope/lifespan-calculator.git"
  },
  "dependencies": {
    "@astrojs/react": "7.1.2",
    "astro": "7.4.8",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.66.0",
    "react": "^19.2.0",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsdom": "30.1.3",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}

---
// The one HTML document for every page. Head tags come from src/routes.meta.js via src/lib/head.js.
// Inline scripts are `is:inline` (Astro must not bundle or defer them); their order matters:
// 1. the share-link scrubber runs before the analytics script ever loads,
// 2. the theme is applied before first paint.
import '../index.css'
import { ROUTE_META, NOT_FOUND_META } from '../routes.meta.js'
import { headTags, notFoundTags } from '../lib/head.js'

interface Props {
  route?: string
  notFound?: boolean
  embed?: boolean
  extraJsonLd?: object[]
}

const { route = '/', notFound = false, embed = false, extraJsonLd = [] } = Astro.props
const meta = notFound ? NOT_FOUND_META : ROUTE_META[route]
if (!meta) throw new Error(`Base.astro: no ROUTE_META entry for ${route}`)
const tags = notFound ? notFoundTags(meta) : headTags(meta, route, extraJsonLd)
---
<!doctype html>
<html lang="da">
  <head>
    <meta charset="UTF-8" />
    <!-- Privacy: runs before every other script (notably the analytics script). Moves the share-link
         parameters (g, a, b, m, lf) out of the address into window.__shareQuery (memory only) so they are never
         sent to the statistics server. Other parameters (utm_source, ref, ...) stay. Mirrored by SHARE_KEYS in
         src/utils/shareState.js; src/utils/shareQuery.test.js runs this exact script. -->
    <script is:inline data-share-scrubber>
      (function () {
        try {
          var s = location.search;
          if (!s || s.length < 2) return;
          var keys = { g: 1, a: 1, b: 1, m: 1, lf: 1 };
          var own = [];
          var rest = [];
          s.slice(1).split('&').forEach(function (part) {
            var k = part.split('=')[0];
            try { k = decodeURIComponent(k.replace(/\+/g, ' ')); } catch (e) {}
            (Object.prototype.hasOwnProperty.call(keys, k) ? own : rest).push(part);
          });
          if (!own.length) return;
          window.__shareQuery = own.join('&');
          history.replaceState(history.state, '', location.pathname + (rest.length ? '?' + rest.join('&') : '') + location.hash);
        } catch (e) {}
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f5f8f9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#101519" media="(prefers-color-scheme: dark)" />
    <link rel="preload" href="/fonts/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/source-serif-4-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <!-- Theme before first paint (no flash of the wrong theme). /embed (iframe widget) takes theme and background
         from the query string; every other page uses the saved choice and also drops the key the old cookie
         banner wrote (utils/legacyStorage.js). -->
    {embed ? (
      <script is:inline>
        (function () {
          var h = document.documentElement, q = new URLSearchParams(location.search);
          h.classList.toggle('dark', q.get('theme') === 'dark');
          if (q.get('bg') === 'transparent') h.setAttribute('data-embed-bg', 'transparent');
        })();
      </script>
    ) : (
      <script is:inline>
        (function () {
          try {
            localStorage.removeItem('consent:v1');
            var t = localStorage.getItem('theme');
            if (t === 'dark' || (!t && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
              document.documentElement.classList.add('dark');
            }
          } catch (e) {}
        })();
      </script>
    )}
    <Fragment set:html={tags} />

    <!-- Plausible Analytics. Not on the 404 page, which never had it (the SPA served a static 404.html). -->
    {!notFound && (
      <script is:inline defer data-domain="levetidsberegner.dk" src="https://analytics.holstjensen.eu/js/script.file-downloads.outbound-links.pageview-props.tagged-events.js"></script>
      <script is:inline>window.plausible = window.plausible || function() { (window.plausible.q = window.plausible.q || []).push(arguments) }</script>
    )}
    <link rel="manifest" href="/manifest.webmanifest" />
    <!-- Service worker (public/sw.js is generated by scripts/build-sw.mjs). Inline, so content pages load no
         script file of their own. Not on /embed: the widget runs inside other sites. -->
    {!embed && (
      <script is:inline>
        if ('serviceWorker' in navigator) {
          window.addEventListener('load', function () { navigator.serviceWorker.register('/sw.js', { scope: '/' }); });
        }
      </script>
    )}
  </head>
  <body>
    <div id="root">
      <div class="min-h-screen bg-background font-sans antialiased">
        <slot />
      </div>
    </div>
    {!embed && (
      <script is:inline>
        // Theme switch (components/ThemeToggle.jsx renders the button without JS). The icon follows the
        // `dark` class through CSS; only the label is set here.
        (function () {
          var root = document.documentElement;
          function label() {
            var dark = root.classList.contains('dark');
            document.querySelectorAll('[data-theme-toggle]').forEach(function (b) {
              b.setAttribute('aria-label', dark ? 'Skift til lys tilstand' : 'Skift til mørk tilstand');
            });
          }
          function set(theme) {
            root.classList.toggle('dark', theme === 'dark');
            label();
          }
          document.addEventListener('click', function (e) {
            var b = e.target.closest && e.target.closest('[data-theme-toggle]');
            if (!b) return;
            var next = root.classList.contains('dark') ? 'light' : 'dark';
            try { localStorage.setItem('theme', next); } catch (err) {}
            set(next);
          });
          // Keep in sync when another tab changes the saved preference.
          window.addEventListener('storage', function (e) {
            if (e.key === 'theme' && e.newValue) set(e.newValue);
          });
          label();
        })();
      </script>
    )}
  </body>
</html>

{
  "name": "lifespan-calculator",
  "version": "1.0.0",
  "description": "Danish Lifespan Calculator - Interactive React web application",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/gen-sitemap.mjs",
    "build": "vite build",
    "postbuild": "node scripts/prerender-head.mjs",
    "preview": "vite preview",
    "start": "vite preview --port 3000",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx}\"",
    "test:e2e": "playwright test"
  },
  "keywords": [
    "lifespan",
    "calculator",
    "danish",
    "statistics",
    "health",
    "react"
  ],
  "author": "Mads Holst Jensen <mahope.dk>",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "homepage": "https://github.com/mahope/lifespan-calculator",
  "repository": {
    "type": "git",
    "url": "https://github.com/mahope/lifespan-calculator.git"
  },
  "dependencies": {
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.66.0",
    "react": "^19.2.0",
    "react-dom": "^19.3.1",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsdom": "30.1.3",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "serve": "14.2.6",
    "tailwindcss": "^4.3.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.12"
  }
}

---
// Static survival curve as inline SVG (no JS): share of the cohort still alive by age.
interface Props {
  points: [number, number][]
  median: number
  death: number
  label: string
}
const { points, median, death, label } = Astro.props
const W = 600, H = 280, L = 46, R = 14, T = 14, B = 34
const a0 = points[0][0], a1 = points.at(-1)![0]
const x = (a: number) => L + ((a - a0) / (a1 - a0)) * (W - L - R)
const y = (p: number) => T + (1 - p) * (H - T - B)
const d = points.map(([a, p], i) => `${i ? 'L' : 'M'}${x(a).toFixed(1)} ${y(p).toFixed(1)}`).join(' ')
const area = `${d} L${x(a1).toFixed(1)} ${y(0)} L${x(a0).toFixed(1)} ${y(0)} Z`
const ticks = Array.from({ length: Math.floor((a1 - a0) / 10) + 1 }, (_, i) => Math.ceil(a0 / 10) * 10 + i * 10).filter((t) => t >= a0 && t <= a1)
---

<svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={label} class="w-full h-auto text-foreground">
  {[0, 0.25, 0.5, 0.75, 1].map((p) => (
    <g>
      <line x1={L} x2={W - R} y1={y(p)} y2={y(p)} stroke="currentColor" stroke-opacity="0.12" />
      <text x={L - 6} y={y(p) + 4} text-anchor="end" font-size="11" fill="currentColor" fill-opacity="0.7">{Math.round(p * 100)} %</text>
    </g>
  ))}
  {ticks.map((t) => (
    <text x={x(t)} y={H - 12} text-anchor="middle" font-size="11" fill="currentColor" fill-opacity="0.7">{t}</text>
  ))}
  <path d={area} fill="hsl(var(--primary))" fill-opacity="0.12"></path>
  <path d={d} fill="none" stroke="hsl(var(--primary))" stroke-width="2.5" stroke-linejoin="round"></path>
  <line x1={x(median)} x2={x(median)} y1={y(0.5)} y2={y(0)} stroke="currentColor" stroke-dasharray="4 3" stroke-opacity="0.6"></line>
  <circle cx={x(median)} cy={y(0.5)} r="4" fill="hsl(var(--primary))"></circle>
  <line x1={x(death)} x2={x(death)} y1={T} y2={y(0)} stroke="hsl(var(--primary))" stroke-dasharray="2 3" stroke-opacity="0.8"></line>
</svg>
